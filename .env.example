# Template for .env — commit this, never the real one.
# Copy to .env and fill in the blanks:  cp .env.example .env

# Where the app under test lives.
APP_BASE_URL=http://localhost:3000

# Credentials for the account the suite signs in as.
APP_USER_EMAIL=you@example.com
APP_USER_PASSWORD=your-password

# How long one LLM turn may take to stream to completion (ms).
APP_TIMETOUT_MS=120000
